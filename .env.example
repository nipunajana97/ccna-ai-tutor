# Copy this to .env for local use. Set these securely in Render for deployment.
DEMO_MODE=false
LOCAL_AI_TEST=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Optional only for a remote Ollama server behind your authenticated HTTPS proxy.
OLLAMA_AUTH_TOKEN=
# Gemini is an optional legacy backend, selected only with AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1UQdZaCvG4xAhKW62tQteiuU
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_aFa7sKfRceuj6BsfQk6wE00
BILLING_MODE=test
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
APP_URL=http://localhost:8501
DATA_DIR=./data
DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_REQUEST_LIMIT=500
REQUEST_COOLDOWN_SECONDS=10
